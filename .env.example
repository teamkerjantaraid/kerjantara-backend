# DATABASE CONFIGURATION
DATABASE_URL=postgresql://kerjantara:localdev@localhost:5432/kerjantara?sslmode=disable
# Atau pakai Supabase jika dideploy ke Supabase
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# STORAGE CONFIGURATION (MinIO / Supabase Storage)
# Dev Lokal (MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
SUPABASE_STORAGE_BUCKET=kerjantara

# Prod (Supabase S3 API)
# STORAGE_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3
# STORAGE_ACCESS_KEY=<project-ref>
# STORAGE_SECRET_KEY=<supabase-service-key>

# JWT AUTHENTICATION
JWT_SECRET=super-secret-key-that-is-at-least-32-chars-long
# Supabase JWT Secret untuk verifikasi token Google OAuth (Settings > API > JWT Secret)
SUPABASE_JWT_SECRET=supabase-JWT_SECRET

# PAYMENT GATEWAY (Midtrans Sandbox)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx

# APPLICATION SETTINGS
APP_PORT=8080
# Host untuk Swagger UI (format: host:port atau domain). Default: localhost:8080
# Contoh pakai ngrok: APP_HOST=abc123.ngrok.io
APP_HOST=localhost:8080
RESPONSE_WINDOW_MINUTES=15
GPS_TOLERANCE_METERS=50

# LOGGING
# Set LOG_QUERIES=true untuk menampilkan setiap SQL query di log (development only)
LOG_QUERIES=true

# CORS SETTING (Set ke domain ngrok saat demo tunnel)
CORS_ALLOWED_ORIGIN=*
